# ============================================================
# Maiconsoft Factory — variáveis de ambiente
# Copie para .env (o install.sh faz isso) e PREENCHA os valores.
# NUNCA commite o .env — o repo é público.
# ============================================================

# Bancos de dados (Langfuse / n8n)
POSTGRES_PASSWORD=troque-este-valor
LANGFUSE_NEXTAUTH_SECRET=troque-este-valor
LANGFUSE_SALT=troque-este-valor
LANGFUSE_ENCRYPTION_KEY=troque-este-valor
N8N_ENCRYPTION_KEY=troque-este-valor

# Observabilidade / segurança (perfis ops e sec)
GRAFANA_ADMIN_PASSWORD=troque-este-valor
VAULTWARDEN_ADMIN_TOKEN=troque-este-valor
KEYCLOAK_ADMIN_PASSWORD=troque-este-valor

# Paperclip — token de board (opcional em local_trusted;
# preencha se a API exigir Authorization: Bearer)
PAPERCLIP_TOKEN=

# Tailscale (perfil remote) — auth key de https://login.tailscale.com/admin/authkeys
TS_AUTHKEY=
